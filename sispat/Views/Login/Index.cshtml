
@model SiPat.Models.Login

@{
    ViewBag.Title = "Iniciar sesión";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Patria | Iniciar sesión</title>


    <!-- ===================================================== -->
    <!-- FONT AWESOME                                          -->
    <!-- ===================================================== -->

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />


    <!-- ===================================================== -->
    <!-- SWEET ALERT                                           -->
    <!-- ===================================================== -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" />


    <!-- ===================================================== -->
    <!-- CSS DEL LOGIN                                         -->
    <!-- ===================================================== -->

    <link rel="stylesheet"
          href="@Url.Content("~/Content/Login/Login.css")" />

</head>


<body>


    <!-- ===================================================== -->
    <!-- CONTENEDOR PRINCIPAL                                  -->
    <!-- ===================================================== -->

    <main class="login-page">


        <!-- ================================================= -->
        <!-- LADO IZQUIERDO                                    -->
        <!-- ================================================= -->

        <section class="brand-side">

            <div class="brand-side__overlay"></div>


            <div class="brand-side__quote">

                <span>NUESTRAS</span>

                <span>RAÍCES</span>

                <span>TAMBIÉN</span>

                <span>DECIDEN</span>

                <i></i>

            </div>

        </section>



        <!-- ================================================= -->
        <!-- LADO DERECHO                                      -->
        <!-- ================================================= -->

        <section class="photo-side">

            <div class="photo-side__overlay"></div>


            <!-- ============================================= -->
            <!-- TEXTO SUPERIOR                                -->
            <!-- ============================================= -->

            <div class="photo-side__top">

                <strong>COLIMA</strong>

                <span></span>

                <small>TIERRA</small>

                <small>GENTE</small>

                <small>FUTURO</small>

            </div>



            <!-- ============================================= -->
            <!-- TEXTO INFERIOR                                -->
            <!-- ============================================= -->

            <div class="photo-side__bottom">

                <i></i>

                <span>
                    LA TRANSFORMACIÓN AVANZA CONTIGO
                </span>

                <i></i>

            </div>

        </section>



        <!-- ================================================= -->
        <!-- TARJETA LOGIN                                     -->
        <!-- ================================================= -->

        <section class="login-card">


            <!-- ============================================= -->
            <!-- LOGO                                          -->
            <!-- ============================================= -->

            <div class="brand">


                <!-- ÁGUILA -->

                <div class="eagle-wrap">

                    <img src="@Url.Content("~/Content/Login/Images/patria-eagle.png")"
                         alt="Patria"
                         class="eagle-logo" />

                </div>



                <!-- ========================================= -->
                <!-- PATRIA                                    -->
                <!-- ========================================= -->

                <div class="patria-word"
                     aria-label="PATRIA">

                    <span>P</span>

                    <span>A</span>

                    <span>T</span>

                    <span>R</span>

                    <span>I</span>

                    <span>A</span>

                </div>

            </div>



            <!-- ============================================= -->
            <!-- TITULO                                        -->
            <!-- ============================================= -->

            <h1>
                Te damos la Bienvenida
            </h1>


            <p class="subtitle">
                Ingresa a tu cuenta para continuar
            </p>



            <!-- ================================================= -->
            <!-- FORMULARIO                                         -->
            <!-- ================================================= -->

            @using (Html.BeginForm(
                "Login",
                "Account",
                FormMethod.Post,
                new
                {
                    id = "loginForm",
                    autocomplete = "off",
                    novalidate = "novalidate"
                }))
            {

                @Html.AntiForgeryToken()



                <!-- ============================================= -->
                <!-- USUARIO                                      -->
                <!-- ============================================= -->

                <div class="field">


                    <i class="fa-regular fa-user field-icon"></i>


                    @Html.TextBoxFor(
                        m => m.Usuario,
                        new
                        {
                            @class = "form-control",
                            id = "Usuario",
                            maxlength = "8",
                            minlength = "8",
                            autocomplete = "username",
                            placeholder = "Usuario",
                            aria_label = "Usuario"
                        })


                    <span class="field-line"></span>

                </div>



                <!-- ============================================= -->
                <!-- CONTRASEÑA                                   -->
                <!-- ============================================= -->

                <div class="field">


                    <i class="fa-solid fa-lock field-icon"></i>


                    @Html.PasswordFor(
                        m => m.Contrasena,
                        new
                        {
                            @class = "form-control",
                            id = "Contrasena",
                            maxlength = "8",
                            minlength = "8",
                            autocomplete = "current-password",
                            placeholder = "Contraseña",
                            aria_label = "Contraseña"
                        })



                    <!-- BOTÓN MOSTRAR CONTRASEÑA -->

                    <button type="button"
                            class="password-toggle"
                            id="togglePassword"
                            aria-label="Mostrar contraseña">

                        <i class="fa-regular fa-eye-slash"></i>

                    </button>


                    <span class="field-line"></span>

                </div>



                <!-- ============================================= -->
                <!-- MENSAJES DE VALIDACIÓN MVC                    -->
                <!-- ============================================= -->

                @Html.ValidationSummary(
                    true,
                    "",
                    new
                    {
                        @class = "text-danger"
                    })



                <!-- ================================================= -->
                <!-- RECAPTCHA                                        -->
                <!-- ================================================= -->

                <div class="recaptcha-box">


                    <div class="recaptcha-icon">

                        <i class="fa-solid fa-shield-halved"></i>

                    </div>


                    <div>

                        <strong>
                            Este sitio está protegido con reCAPTCHA
                        </strong>


                        <small>

                            Se aplican la
                            <u>Política de Privacidad</u>

                            y los

                            <u>Términos de Servicio</u>

                            de Google.

                        </small>

                    </div>

                </div>



                <!-- ================================================= -->
                <!-- BOTÓN LOGIN                                       -->
                <!-- ================================================= -->

                <button type="submit"
                        class="btn-login"
                        id="btnLogin">


                    <span>
                        Iniciar sesión
                    </span>


                    <i class="fa-solid fa-arrow-right"></i>

                </button>



                <!-- ================================================= -->
                <!-- RECUPERAR CONTRASEÑA                             -->
                <!-- ================================================= -->

                <a href="@Url.Action(
                    "ForgotPassword",
                    "Account")"
                   class="forgot">

                    ¿Olvidaste tu contraseña?

                </a>

            }


        </section>


    </main>



    <!-- ===================================================== -->
    <!-- SWEET ALERT JS                                        -->
    <!-- ===================================================== -->

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>



    <!-- ===================================================== -->
    <!-- CONFIGURACIÓN                                        -->
    <!-- ===================================================== -->

    <script>

        window.LoginConfig = {

            loginUrl: '@Url.Action(
                "Login",
                "Account")'

        };

    </script>



    <!-- ===================================================== -->
    <!-- JAVASCRIPT DEL LOGIN                                 -->
    <!-- ===================================================== -->

    <script src="@Url.Content("~/Scripts/Login/Login.js")"></script>



    <!-- ===================================================== -->
    <!-- ERROR DEVUELTO DESDE EL CONTROLLER                   -->
    <!-- ===================================================== -->

    @if (TempData["LoginError"] != null)
    {
        <script>

            document.addEventListener(
                "DOMContentLoaded",
                function () {

                    Swal.fire({

                        icon: "error",

                        title:
                            "No fue posible iniciar sesión",

                        text:
                            @Html.Raw(
                                Json.Encode(
                                    TempData["LoginError"]
                                )
                            ),

                        confirmButtonText:
                            "Aceptar",

                        confirmButtonColor:
                            "#7f2841"

                    });

                }
            );

        </script>
    }


</body>

</html>